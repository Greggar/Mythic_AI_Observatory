# Telegram alert credentials for log_alerter.sh
# Copy this file to ~/.config/mythic/log_alerter.env and fill in your values.
#
# How to create a Telegram bot:
#   1. Message @BotFather on Telegram
#   2. Send /newbot and follow prompts
#   3. Copy the token it gives you as BOT_TOKEN below
#   4. Message your new bot (any message)
#   5. Visit https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   6. Copy the "chat":{"id":...} value as TELEGRAM_TARGET below

BOT_TOKEN=your_bot_token_here
TELEGRAM_TARGET=your_chat_id_here
