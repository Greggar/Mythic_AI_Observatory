# ── Mythic AI Observatory — Frontend Environment Variables ────────
#
# Copy this file to set up your environment:
#   cp .env.example .env.local        # for development overrides
#
# ────────────────────────────────────────────────────────────────────

# Backend API base URL (used by useOrchestrate.ts, useWebSocket.ts)
# Dev default (already hardcoded as fallback): http://localhost:8001
# Production: set to your server's LAN IP, e.g. http://192.168.0.1:8001
# NEXT_PUBLIC_API_URL=http://localhost:8001
